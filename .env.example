# Publishable (anon) key only. Never put the service role key, a Google client secret, or an Apple secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Sync runs when someone is signed in. Set this to the string false to turn sync off.
# EXPO_PUBLIC_SYNC_ENABLED=false
# Google and Apple buttons. Leave unset until those providers are enabled in Supabase.
# EXPO_PUBLIC_OAUTH_PROVIDERS=google,apple
# Public web client id for Google Identity Services. Not a secret. The client secret stays in Supabase.
# Leave unset to keep the Supabase Google redirect.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=129452132407-vqeapd2vu4md3qn81t439kpdbocksghq.apps.googleusercontent.com
# Crash reports. Leave unset. Set the string true only after the client_errors migration is applied.
# EXPO_PUBLIC_ERROR_REPORTING=true
